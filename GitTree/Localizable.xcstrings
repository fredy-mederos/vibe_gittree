          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua cartella non esiste più, quindi git dimentica solo il worktree."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダはすでにないため、gitはワークツリーの記録を消すだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
