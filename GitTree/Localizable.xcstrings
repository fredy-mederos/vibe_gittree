        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले से मर्ज हुआ: इस ब्रांच के कमिट रीबेस या चेरी-पिक के ज़रिए मुख्य ब्रांच में कॉपी किए गए हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah di-merge: commit-nya di-rebase atau di-cherry-pick ke branch utama"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
