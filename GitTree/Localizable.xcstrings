    "This Mac can't run Apple's on-device model, so work without a term stays under Other." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لجهاز Mac هذا تشغيل نموذج Apple على الجهاز، لذا يبقى العمل الذي لا يحمل مصطلحًا ضمن «أخرى»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann Apples Modell auf dem Gerät nicht ausführen, daher bleiben Commits ohne Begriff unter „Sonstiges“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no puede ejecutar el modelo de Apple en el dispositivo, así que el trabajo sin término se queda en Otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut pas exécuter le modèle sur l’appareil d’Apple : le travail sans terme reste dans « Autres »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह Mac Apple का ऑन-डिवाइस मॉडल नहीं चला सकता, इसलिए बिना शब्द वाला काम अन्य में ही रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini tidak dapat menjalankan model on-device Apple, jadi pekerjaan tanpa istilah tetap ada di Lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non può eseguire il modello di Apple sul dispositivo, quindi il lavoro senza un termine resta in Altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacではAppleのオンデバイスモデルを実行できないため、キーワードのない作業は「その他」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 Apple 온디바이스 모델을 실행할 수 없어 키워드가 없는 작업은 기타에 남습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini tidak dapat menjalankan model pada peranti Apple, jadi kerja tanpa istilah kekal di bawah Lain-lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac kan het on-device model van Apple niet uitvoeren, dus werk zonder term blijft onder Overig staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac nie może uruchomić modelu Apple działającego na urządzeniu, więc praca bez słowa kluczowego pozostaje w grupie Inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac não consegue executar o modelo no dispositivo da Apple, então o trabalho sem termo fica em Outros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac не может запустить модель Apple на устройстве, поэтому работа без термина остаётся в группе «Другое»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac เครื่องนี้ไม่สามารถรันโมเดลบนอุปกรณ์ของ Apple ได้ งานที่ไม่มีคำสำคัญจึงอยู่ใน “อื่นๆ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac, Apple’ın cihaz üzerindeki modelini çalıştıramıyor, bu yüzden terimi olmayan işler Diğer altında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Mac не може запускати модель Apple на пристрої, тому робота без ключового слова залишається в групі «Інше»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy Mac này không thể chạy mô hình trên thiết bị của Apple, nên công việc không có thuật ngữ vẫn nằm trong Khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 无法运行 Apple 的设备端模型，因此没有关键词的工作仍归在“其他”下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部 Mac 無法執行 Apple 的裝置端模型，因此沒有關鍵字的工作會留在「其他」。"
          }
        }
      }
    },
