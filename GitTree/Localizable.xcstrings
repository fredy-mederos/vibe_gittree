    "A regular expression for tags that mark a production release. The details show the first release that contains a commit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعبير نمطي للوسوم التي تحدد إصدارًا إنتاجيًا. تعرض التفاصيل أول إصدار يحتوي على إيداع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein regulärer Ausdruck für Tags, die ein Produktions-Release kennzeichnen. Die Details zeigen das erste Release, das einen Commit enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una expresión regular para las etiquetas que marcan un lanzamiento a producción. Los detalles muestran el primer lanzamiento que contiene un commit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une expression régulière pour les tags qui marquent une release en production. Les détails indiquent la première release qui contient un commit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोडक्शन रिलीज़ को चिह्नित करने वाले टैग के लिए रेगुलर एक्सप्रेशन। विवरण में वह पहला रिलीज़ दिखाया जाता है जिसमें कोई कमिट शामिल है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspresi reguler untuk tag yang menandai rilis produksi. Detail menampilkan rilis pertama yang berisi sebuah commit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’espressione regolare per i tag che indicano un rilascio in produzione. I dettagli mostrano il primo rilascio che contiene un commit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本番リリースを示すタグの正規表現です。詳細には、コミットを最初に含むリリースが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로덕션 릴리스를 나타내는 태그의 정규 표현식입니다. 세부 정보에는 커밋이 처음 포함된 릴리스가 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular expression untuk tag yang menandakan keluaran produksi. Butiran menunjukkan keluaran pertama yang mengandungi sesuatu commit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een reguliere expressie voor tags die een productierelease aanduiden. De details tonen de eerste release die een commit bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrażenie regularne dla tagów oznaczających wydanie produkcyjne. Szczegóły pokazują pierwsze wydanie, które zawiera dany commit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma expressão regular para as tags que marcam um lançamento em produção. Os detalhes mostram o primeiro lançamento que contém um commit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярное выражение для тегов, которыми отмечены релизы в продакшен. В подробностях показан первый релиз, содержащий коммит."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นิพจน์ปกติสำหรับแท็กที่ระบุรีลีสที่ใช้งานจริง ส่วนรายละเอียดจะแสดงรีลีสแรกที่มีคอมมิต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üretim yayınını işaretleyen etiketler için bir düzenli ifade. Ayrıntılar, bir commit’i içeren ilk yayını gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярний вираз для тегів, що позначають продакшн-реліз. У подробицях показано перший реліз, який містить коміт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biểu thức chính quy cho các tag đánh dấu một bản phát hành production. Khung Chi tiết hiển thị bản phát hành đầu tiên chứa một commit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正则表达式，用于匹配标记正式发布的标签。详情中会显示包含某个提交的第一个发布版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用來判斷哪些標籤代表正式發行版本的正規表示式。詳細資訊會顯示包含某個提交的第一個發行版本。"
          }
        }
      }
    },
    "A regular expression for this repository's fix versions in Releases, like Android or ^iOS, when its Jira project's tickets don't tell (a project shared by several apps, say). Leave it empty for the fix versions its tickets are in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعبير نمطي لإصدارات الإصلاح الخاصة بهذا المستودع في قسم الإصدارات، مثل Android أو ^iOS، عندما لا تحدّد تذاكر مشروع Jira الخاص به ذلك (كأن يشاركه عدة تطبيقات مثلًا). اتركه فارغًا لاستخدام إصدارات الإصلاح التي توجد فيها تذاكره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein regulärer Ausdruck für die Fix-Versionen dieses Repositorys unter „Releases“, wie Android oder ^iOS, falls die Tickets seines Jira-Projekts nichts darüber verraten (zum Beispiel bei einem Projekt, das sich mehrere Apps teilen). Leer lassen, um die Fix-Versionen zu verwenden, in denen seine Tickets stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una expresión regular para las versiones de corrección de este repositorio en Lanzamientos, como Android o ^iOS, cuando los tickets de su proyecto de Jira no lo indican (por ejemplo, un proyecto compartido por varias apps). Déjalo vacío para usar las versiones de corrección en las que están sus tickets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une expression régulière pour les versions corrigées de ce dépôt dans Releases, comme Android ou ^iOS, lorsque les tickets de son projet Jira ne les indiquent pas (un projet partagé par plusieurs apps, par exemple). Laissez ce champ vide pour utiliser les versions corrigées de ses tickets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिलीज़ में इस रिपॉज़िटरी के फ़िक्स वर्ज़न के लिए रेगुलर एक्सप्रेशन, जैसे Android या ^iOS, जब इसके Jira प्रोजेक्ट के टिकट से यह पता न चले (जैसे, कई ऐप्स द्वारा साझा किया गया प्रोजेक्ट)। जिन फ़िक्स वर्ज़न में इसके टिकट हैं, उनके लिए इसे खाली छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspresi reguler untuk versi perbaikan repositori ini di Rilis, seperti Android atau ^iOS, saat tiket proyek Jira-nya tidak menentukannya (misalnya proyek yang dipakai bersama beberapa aplikasi). Biarkan kosong untuk memakai versi perbaikan tempat tiketnya berada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’espressione regolare per le versioni di correzione di questo repository in Rilasci, come Android o ^iOS, quando i ticket del suo progetto Jira non le indicano (ad esempio un progetto condiviso da più app). Lascia vuoto per usare le versioni di correzione in cui si trovano i suoi ticket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「リリース」に表示するこのリポジトリの修正バージョンを絞り込む正規表現です（Androidや^iOSなど）。Jiraプロジェクトの課題から判別できない場合（複数のアプリで共有しているプロジェクトなど）に使います。空のままにすると、課題が属する修正バージョンが使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴리스에서 이 저장소의 수정 버전을 가려내는 정규 표현식입니다(예: Android 또는 ^iOS). Jira 프로젝트의 티켓만으로는 알 수 없을 때(예: 여러 앱이 프로젝트 하나를 공유하는 경우) 사용합니다. 비워 두면 티켓이 속한 수정 버전을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular expression untuk fix version repositori ini dalam Keluaran, seperti Android atau ^iOS, apabila tiket projek Jira repositori ini tidak menentukannya (projek yang dikongsi oleh beberapa app, misalnya). Biarkan kosong untuk fix version yang ditetapkan pada tiketnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een reguliere expressie voor de fix versions van deze repository in Releases, zoals Android of ^iOS, voor als de tickets van het Jira-project het niet aangeven (bijvoorbeeld een project dat door meerdere apps wordt gedeeld). Laat leeg voor de fix versions waarin de tickets zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrażenie regularne dla wersji poprawek tego repozytorium w sekcji Wydania, np. Android lub ^iOS, gdy zgłoszenia jego projektu Jira tego nie wskazują (na przykład gdy projekt jest wspólny dla kilku aplikacji). Pozostaw puste, aby użyć wersji poprawek, w których są jego zgłoszenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma expressão regular para as versões de correção deste repositório em Lançamentos, como Android ou ^iOS, quando os tickets do projeto Jira dele não indicam (um projeto compartilhado por vários apps, por exemplo). Deixe vazio para usar as versões de correção em que os tickets dele estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярное выражение для версий исправления этого репозитория в разделе «Релизы», например Android или ^iOS, когда тикеты его проекта Jira этого не определяют (скажем, проект общий для нескольких приложений). Оставьте поле пустым, чтобы брать версии исправления, в которых есть его тикеты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นิพจน์ปกติสำหรับเวอร์ชันที่แก้ไขของรีโพซิทอรีนี้ในรีลีส เช่น Android หรือ ^iOS ใช้เมื่อทิกเก็ตของโปรเจกต์ Jira ไม่ได้ระบุไว้ชัดเจน (เช่น โปรเจกต์ที่หลายแอปใช้ร่วมกัน) เว้นว่างไว้เพื่อใช้เวอร์ชันที่แก้ไขที่ทิกเก็ตของรีโพซิทอรีอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu deponun Yayınlar’daki düzeltme sürümleri için bir düzenli ifade, örneğin Android veya ^iOS; Jira projesinin ticket’leri bunu belirtmediğinde kullanılır (örneğin birden çok uygulamanın paylaştığı bir proje). Ticket’lerinin bulunduğu düzeltme sürümleri için boş bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярний вираз для версій виправлення цього репозиторію в розділі «Релізи», як-от Android або ^iOS, якщо тікети його проєкту Jira цього не визначають (наприклад, проєкт, спільний для кількох програм). Залиште порожнім, щоб брати версії виправлення, у яких перебувають його тікети."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biểu thức chính quy cho các phiên bản sửa lỗi của kho lưu trữ này trong Bản phát hành, như Android hoặc ^iOS, khi các ticket của dự án Jira của kho không cho biết (chẳng hạn một dự án dùng chung cho nhiều ứng dụng). Để trống để dùng các phiên bản sửa lỗi mà ticket của nó thuộc về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正则表达式，用于匹配此仓库在“发布”中的修复版本，例如 Android 或 ^iOS；适用于 Jira 项目的工单无法确定版本的情况（比如一个项目由多个应用共用）。留空则使用其工单所属的修复版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用來指定此儲存庫在「發行版本」中要顯示哪些修正版本的正規表示式（例如 Android 或 ^iOS），適用於其 Jira 專案的議題無法判斷的情況（例如多個 App 共用一個專案）。留空則使用其議題所屬的修正版本。"
          }
        }
      }
    },
