    "Install the GitHub CLI (brew install gh) and run `gh auth login` to see pull request timelines." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت GitHub CLI (brew install gh) ثم نفّذ `gh auth login` لعرض الجداول الزمنية لطلبات السحب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere die GitHub CLI (brew install gh) und führe `gh auth login` aus, um Pull-Request-Zeitleisten zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala GitHub CLI (brew install gh) y ejecuta `gh auth login` para ver la cronología de los pull requests."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez GitHub CLI (brew install gh) et exécutez `gh auth login` pour voir les chronologies des pull requests."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुल रिक्वेस्ट की टाइमलाइन देखने के लिए GitHub CLI इंस्टॉल करें (brew install gh) और `gh auth login` चलाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instal GitHub CLI (brew install gh) dan jalankan `gh auth login` untuk melihat linimasa pull request."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa la CLI di GitHub (brew install gh) ed esegui `gh auth login` per vedere le timeline delle pull request."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プルリクエストのタイムラインを表示するには、GitHub CLI（brew install gh）をインストールし、`gh auth login`を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀 리퀘스트 타임라인을 보려면 GitHub CLI(brew install gh)를 설치하고 `gh auth login`을 실행하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasang GitHub CLI (brew install gh) dan jalankan `gh auth login` untuk melihat garis masa pull request."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer de GitHub CLI (brew install gh) en voer `gh auth login` uit om de tijdlijnen van pull requests te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj GitHub CLI (brew install gh) i uruchom `gh auth login`, aby zobaczyć osie czasu pull requestów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o GitHub CLI (brew install gh) e execute `gh auth login` para ver as linhas do tempo dos pull requests."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите GitHub CLI (brew install gh) и выполните `gh auth login`, чтобы видеть хронологию пулл-реквестов."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตั้ง GitHub CLI (brew install gh) และรัน `gh auth login` เพื่อดูไทม์ไลน์ของพูลรีเควสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
