    "Turn on Apple Intelligence in System Settings to sort work that has no term; until then it's under Other." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل Apple Intelligence في إعدادات النظام لفرز العمل الذي لا يحمل مصطلحًا؛ وإلى ذلك الحين يبقى ضمن «أخرى»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Apple Intelligence in den Systemeinstellungen, um Commits ohne Begriff zu sortieren; bis dahin stehen sie unter „Sonstiges“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Apple Intelligence en Ajustes del Sistema para ordenar el trabajo sin término; hasta entonces está en Otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans les Réglages Système pour classer le travail sans terme ; d’ici là, il reste dans « Autres »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना शब्द वाले काम को छाँटने के लिए सिस्टम सेटिंग में Apple Intelligence चालू करें; तब तक वह अन्य में रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Apple Intelligence di Pengaturan Sistem untuk mengurutkan pekerjaan yang tidak punya istilah; sampai saat itu, pekerjaan tersebut ada di Lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Apple Intelligence in Impostazioni di Sistema per ordinare il lavoro senza un termine; fino ad allora si trova in Altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワードのない作業を振り分けるには、システム設定でApple Intelligenceをオンにしてください。それまでは「その他」に入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드가 없는 작업을 분류하려면 시스템 설정에서 Apple Intelligence를 켜세요. 그때까지는 기타에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidupkan Apple Intelligence dalam Tetapan Sistem untuk menyusun kerja yang tiada istilah; sehingga itu ia berada di bawah Lain-lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Apple Intelligence aan in Systeeminstellingen om werk zonder term te sorteren; tot dan staat het onder Overig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Apple Intelligence w Ustawieniach systemowych, aby sortować pracę bez słowa kluczowego; do tego czasu jest w grupie Inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Apple Intelligence nos Ajustes do Sistema para classificar o trabalho sem termo; até lá, ele fica em Outros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Apple Intelligence в Системных настройках, чтобы сортировать работу без термина; до тех пор она остаётся в группе «Другое»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด Apple Intelligence ในการตั้งค่าระบบเพื่อจัดเรียงงานที่ไม่มีคำสำคัญ จนกว่าจะเปิด งานเหล่านั้นจะอยู่ใน “อื่นๆ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terimi olmayan işleri sıralamak için Sistem Ayarları’nda Apple Intelligence’ı açın; o zamana kadar Diğer altında yer alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть Apple Intelligence у розділі «Параметри системи», щоб сортувати роботу без ключового слова; доти вона в групі «Інше»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bật Apple Intelligence trong Cài đặt hệ thống để sắp xếp công việc không có thuật ngữ; cho tới lúc đó, nó nằm trong Khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中开启 Apple Intelligence，即可对没有关键词的工作分类；在此之前，它们归在“其他”下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」中開啟 Apple Intelligence，以整理沒有關鍵字的工作；在此之前它會歸在「其他」。"
          }
        }
      }
    },
    "Uncommitted Changes" : {
      "localizations" : {
        "ar" : {
