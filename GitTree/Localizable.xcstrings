    "Vibe GitTree" : {
      "shouldTranslate" : false
    },
    "Vibe GitTree asks Jira for the tickets in this fix version and highlights the commits that mention them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل Vibe GitTree موقع Jira عن التذاكر في إصدار الإصلاح هذا ويميّز الإيداعات التي تذكرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree fragt Jira nach den Tickets in dieser Fix-Version und hebt die Commits hervor, die sie erwähnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree consulta en Jira los tickets de esta versión de corrección y resalta los commits que los mencionan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree demande à Jira les tickets de cette version corrigée et surligne les commits qui les mentionnent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree Jira से इस फ़िक्स वर्ज़न के टिकट माँगता है और उन टिकट का उल्लेख करने वाले कमिट हाइलाइट करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree bertanya ke Jira soal tiket di versi perbaikan ini dan menyorot commit yang menyebutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree chiede a Jira i ticket di questa versione di correzione ed evidenzia i commit che li menzionano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTreeは、この修正バージョンの課題をJiraに問い合わせ、それらに言及するコミットをハイライトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree가 이 수정 버전의 티켓을 Jira에 요청하고, 해당 티켓을 언급하는 커밋을 강조 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree bertanya kepada Jira tentang tiket dalam fix version ini dan menyerlahkan commit yang menyebutnya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree vraagt Jira om de tickets in deze fix version en markeert de commits die ze noemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree pobiera z Jira zgłoszenia w tej wersji poprawki i wyróżnia commity, które o nich wspominają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vibe GitTree consulta o Jira sobre os tickets desta versão de correção e destaca os commits que os mencionam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree запрашивает у Jira тикеты этой версии исправления и выделяет коммиты, которые их упоминают."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree จะถาม Jira เรื่องทิกเก็ตในเวอร์ชันที่แก้ไขนี้ และไฮไลต์คอมมิตที่อ้างถึงทิกเก็ตเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree, bu düzeltme sürümündeki ticket’leri Jira’dan ister ve bunlardan söz eden commit’leri vurgular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree запитує в Jira тікети цієї версії виправлення й підсвічує коміти, що їх згадують."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree hỏi Jira về các ticket trong phiên bản sửa lỗi này và tô sáng các commit nhắc đến chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree 会向 Jira 查询此修复版本中的工单，并高亮提及它们的提交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree 會向 Jira 查詢此修正版本中的議題，並醒目標示提到這些議題的提交。"
          }
        }
      }
    },
