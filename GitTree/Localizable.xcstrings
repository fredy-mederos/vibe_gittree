            "value" : "Його папки вже немає, тож git лише забуде worktree."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục của nó đã mất, nên git chỉ quên worktree này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
