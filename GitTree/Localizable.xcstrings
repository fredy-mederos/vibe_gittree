        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに適用または破棄されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적용되었거나 삭제되었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia telah digunakan atau dibuang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij is toegepast of gedropt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Został zastosowany lub usunięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele foi aplicado ou descartado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он был применён или удалён."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถูกนำไปใช้หรือดรอปไปแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulanmış veya silinmiş."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його застосовано або видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó đã được áp dụng hoặc bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已被应用或丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已被套用或捨棄。"
          }
        }
      }
    },
    "Its API token is removed from your keychain. Repositories that use it show no ticket statuses until you pick another profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُزال رمز API الخاص به من سلسلة المفاتيح. لن تعرض المستودعات التي تستخدمه حالات التذاكر حتى تختار ملف تعريف آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das zugehörige API-Token wird aus deinem Schlüsselbund entfernt. Repositories, die dieses Profil verwenden, zeigen keine Ticket-Status an, bis du ein anderes Profil wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su token de API se quita de tu llavero. Los repositorios que lo usan no muestran estados de tickets hasta que elijas otro perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son jeton d’API est supprimé de votre trousseau. Les dépôts qui l’utilisent n’affichent aucun statut de ticket tant que vous n’avez pas choisi un autre profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका API टोकन आपके कीचेन से हटा दिया जाता है। इसका उपयोग करने वाली रिपॉज़िटरी तब तक कोई टिकट स्टेटस नहीं दिखातीं, जब तक आप कोई दूसरी प्रोफ़ाइल न चुन लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token API-nya akan dihapus dari Rantai Kunci Anda. Repositori yang memakainya tidak menampilkan status tiket sampai Anda memilih profil lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo token API viene rimosso dal tuo portachiavi. I repository che lo usano non mostrano gli stati dei ticket finché non scegli un altro profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルのAPIトークンはキーチェーンから削除されます。このプロファイルを使っているリポジトリは、別のプロファイルを選ぶまで課題のステータスを表示しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필의 API 토큰이 키체인에서 제거됩니다. 이 프로필을 사용하는 저장소는 다른 프로필을 선택할 때까지 티켓 상태를 표시하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token API-nya dialih keluar daripada rantai kunci anda. Repositori yang menggunakannya tidak menunjukkan status tiket sehingga anda memilih profil lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het API-token wordt uit je sleutelhanger verwijderd. Repositories die het gebruiken tonen geen ticketstatussen totdat je een ander profiel kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego token API zostanie usunięty z pęku kluczy. Repozytoria, które go używają, nie pokażą statusów zgłoszeń, dopóki nie wybierzesz innego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token de API dele é removido do seu chaveiro. Os repositórios que o usam não mostram status de tickets até você escolher outro perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его API-токен будет удалён из вашей связки ключей. Репозитории, которые его используют, не показывают статусы тикетов, пока вы не выберете другой профиль."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โทเค็น API ของโปรไฟล์นี้จะถูกลบออกจากพวงกุญแจ รีโพซิทอรีที่ใช้โปรไฟล์นี้จะไม่แสดงสถานะทิกเก็ตจนกว่าคุณจะเลือกโปรไฟล์อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API belirteci anahtar zincirinizden kaldırılır. Bu profili kullanan depolar, başka bir profil seçene kadar ticket durumu göstermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його токен API буде вилучено з вашої зв’язки ключів. Репозиторії, що його використовують, не показуватимуть статусів тікетів, доки ви не виберете інший профіль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API token của hồ sơ này sẽ bị xóa khỏi chuỗi khóa của bạn. Các kho lưu trữ dùng hồ sơ này sẽ không hiển thị trạng thái ticket cho tới khi bạn chọn hồ sơ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的 API 令牌将从你的钥匙串中移除。使用它的仓库在你选择其他配置文件之前不会显示工单状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的 API 權杖會從你的鑰匙圈中移除。在你選擇其他設定檔之前，使用它的儲存庫不會顯示議題狀態。"
          }
        }
      }
    },
    "Its commit %@ isn't on any branch or tag, so deleting the worktree would lose it. Create a branch for it first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيداع %@ الخاص بشجرة العمل غير موجود على أي فرع أو وسم، لذا سيؤدي حذف شجرة العمل إلى فقدانه. أنشئ له فرعًا أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Commit %@ liegt auf keinem Branch und keinem Tag, daher ginge er beim Löschen des Worktrees verloren. Lege vorher einen Branch dafür an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su commit %@ no está en ninguna rama ni etiqueta, así que al eliminar el worktree se perdería. Crea antes una rama para él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son commit %@ n’est sur aucune branche ni aucun tag : supprimer le worktree le ferait perdre. Créez d’abord une branche pour lui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वर्कट्री के %@ कमिट को किसी भी ब्रांच या टैग में नहीं रखा गया है, इसलिए वर्कट्री डिलीट करने पर वह खो जाएगा। पहले उसके लिए एक ब्रांच बनाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commit %@ tidak berada di branch atau tag mana pun, sehingga menghapus worktree akan menghilangkannya. Buat dulu branch untuk commit tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo commit %@ non si trova su nessun branch né tag, quindi eliminare il worktree lo farebbe perdere. Crea prima un branch per esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークツリーのコミット%@はどのブランチにもタグにもないため、ワークツリーを削除するとこのコミットが失われます。先にこのコミット用のブランチを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 워크트리의 %@ 커밋이 어떤 브랜치나 태그에도 없어서 워크트리를 삭제하면 잃게 됩니다. 먼저 이 커밋용 브랜치를 만드세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commit %@ worktree ini tidak berada pada mana-mana branch atau tag, jadi memadam worktree akan menghilangkannya. Cipta branch untuk commit itu terlebih dahulu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De commit %@ van deze worktree staat op geen enkele branch of tag, dus door de worktree te verwijderen gaat hij verloren. Maak eerst een branch voor hem aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego commit %@ nie znajduje się w żadnej gałęzi ani tagu, więc usunięcie worktree spowodowałoby jego utratę. Najpierw utwórz dla niego gałąź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O commit %@ não está em nenhum branch nem em nenhuma tag, então excluir a worktree o faria se perder. Crie primeiro um branch para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коммит %@ не находится ни в одной ветке и ни на одном теге, поэтому удаление рабочего дерева приведёт к его потере. Сначала создайте для него ветку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอมมิต %@ ของเวิร์กทรีนี้ไม่อยู่บนแบรนช์หรือแท็กใดเลย การลบเวิร์กทรีจะทำให้คอมมิตนี้หายไป สร้างแบรนช์ให้คอมมิตนี้ก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktree’nin commit’i %@ hiçbir dalda veya etikette değil, bu yüzden worktree’yi silmek onu kaybettirir. Önce bu commit için bir dal oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коміт %@ не міститься в жодній гілці чи тегу, тож видалення worktree призведе до його втрати. Спочатку створіть для нього гілку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commit %@ của nó không nằm trên nhánh hay tag nào, nên xóa worktree sẽ làm mất commit đó. Hãy tạo nhánh cho commit này trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的提交 %@ 不在任何分支或标签上，删除工作树会使它丢失。请先为它创建一个分支。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的提交 %@ 不在任何分支或標籤上，刪除工作樹會使它遺失。請先為它建立一個分支。"
          }
        }
      }
    },
    "Its folder is already gone, so git only forgets the worktree." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلدها غير موجود أصلًا، لذا لا يفعل git سوى نسيان شجرة العمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Ordner existiert nicht mehr, daher vergisst git nur den Worktree."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carpeta ya no existe, así que git solo olvida el worktree."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
