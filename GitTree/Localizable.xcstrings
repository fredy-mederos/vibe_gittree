    "Each repository shows ticket statuses from its own Jira, or none." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل مستودع حالات التذاكر من Jira الخاص به، أو لا يعرض أي حالة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Repository zeigt Ticket-Status aus seinem eigenen Jira oder keine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repositorio muestra los estados de los tickets de su propio Jira, o ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque dépôt affiche les statuts de tickets de son propre Jira, ou aucun."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर रिपॉज़िटरी अपने Jira से टिकट स्टेटस दिखाती है, या कोई नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap repositori menampilkan status tiket dari Jira miliknya, atau tidak sama sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni repository mostra gli stati dei ticket dal proprio Jira, oppure nessuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各リポジトリには、それぞれのJiraの課題ステータスが表示されます（Jiraなしも選べます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장소마다 자체 Jira의 티켓 상태를 표시하거나, 표시하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap repositori menunjukkan status tiket daripada Jira miliknya sendiri, atau tiada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke repository toont ticketstatussen uit de eigen Jira, of geen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde repozytorium pokazuje statusy zgłoszeń z własnej instancji Jira albo żadnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repositório mostra os status dos tickets do próprio Jira, ou nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый репозиторий показывает статусы тикетов из своей Jira или не показывает их вовсе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละรีโพซิทอรีจะแสดงสถานะทิกเก็ตจาก Jira ของตัวเอง หรือไม่แสดงเลย"
