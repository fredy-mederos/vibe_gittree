    "List the files by path, with the most changed lines first, or with the most existing lines changed or removed first (new and deleted files last)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض الملفات حسب المسار، مع ترتيب الأكثر تغييرًا أولًا، أو الأكثر تعديلًا أو حذفًا للأسطر الموجودة أولًا (الملفات الجديدة والمحذوفة في الأخير)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien nach Pfad auflisten, mit den meisten geänderten Zeilen zuerst oder mit den meisten bestehenden, geänderten oder entfernten Zeilen zuerst (neue und gelöschte Dateien zuletzt)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listar los archivos por ruta: primero los que tienen más líneas cambiadas, o primero los que tienen más líneas existentes modificadas o eliminadas (los archivos nuevos y eliminados, al final)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lister les fichiers par chemin, avec d’abord ceux qui ont le plus de lignes modifiées, ou d’abord ceux qui ont le plus de lignes existantes modifiées ou supprimées (fichiers nouveaux et supprimés en dernier)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलों को पथ के अनुसार सूचीबद्ध करें: पहले वे जिनमें सबसे ज़्यादा पंक्तियाँ बदली गई हैं, या पहले वे जिनमें सबसे ज़्यादा मौजूदा पंक्तियाँ बदली या हटाई गई हैं (नई और डिलीट की गई फ़ाइलें आख़िर में)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan berkas menurut path, dengan jumlah baris yang berubah terbanyak dahulu, atau jumlah baris yang sudah ada dan diubah atau dihapus terbanyak dahulu (berkas baru dan berkas yang dihapus di akhir)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca i file per percorso, con prima quelli con più righe modificate, oppure prima quelli con più righe esistenti modificate o rimosse (file nuovi ed eliminati per ultimi)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをパス順、変更行の多い順、または既存行の変更・削除の多い順に並べ替えます（新規ファイルと削除されたファイルは最後）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 경로순, 변경된 줄이 많은 순, 또는 기존 줄 중 수정되거나 삭제된 줄이 많은 순으로 나열합니다 (새 파일과 삭제된 파일은 마지막)"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaraikan fail mengikut laluan, dengan bilangan baris yang berubah paling banyak dahulu, atau bilangan baris sedia ada yang diubah suai atau dipadam paling banyak dahulu (fail baharu dan fail yang dipadam di hujung)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden op pad tonen, met eerst de bestanden met de meeste gewijzigde regels, of eerst de bestanden met de meeste bestaande regels die gewijzigd of verwijderd zijn (nieuwe en verwijderde bestanden als laatste)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetl pliki według ścieżki: najpierw te z największą liczbą zmienionych wierszy albo najpierw te z największą liczbą istniejących wierszy zmienionych lub usuniętych (nowe i usunięte pliki na końcu)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listar os arquivos por caminho: primeiro os que têm mais linhas alteradas, ou primeiro os que têm mais linhas existentes alteradas ou removidas (arquivos novos e excluídos por último)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перечислить файлы по пути: сначала с наибольшим числом изменённых строк или сначала с наибольшим числом изменённых или удалённых существующих строк (новые и удалённые файлы — в конце)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงไฟล์ตามพาธ โดยเรียงไฟล์ที่มีบรรทัดเปลี่ยนแปลงมากที่สุดก่อน หรือเรียงไฟล์ที่มีบรรทัดเดิมถูกแก้ไขหรือลบมากที่สุดก่อน (ไฟล์ใหม่และไฟล์ที่ถูกลบอยู่ท้ายสุด)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları yola göre listele: önce en çok satırı değişenler ya da önce en çok mevcut satırı değiştirilen veya silinen olanlar (yeni ve silinen dosyalar en sonda)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перелічити файли за шляхом: спершу ті, де найбільше змінених рядків, або спершу ті, де найбільше змінених чи видалених наявних рядків (нові та видалені файли — наостанок)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liệt kê các tệp theo đường dẫn, với các tệp có nhiều dòng thay đổi nhất lên trước, hoặc các tệp có nhiều dòng có sẵn bị sửa đổi hoặc xóa nhất lên trước (tệp mới và tệp đã xóa xếp cuối)"
          }
        },
        "zh-Hans" : {
