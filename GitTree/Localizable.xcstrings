    "%@ asks GitHub for the newest release when it opens and once a day while it's open. %@ › Check for Updates… asks any time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق %1$@ عبر GitHub من أحدث إصدار عند فتحه ومرة كل يوم ما دام مفتوحًا. ويمكنك التحقق في أي وقت عبر %2$@ › التحقق من وجود تحديثات…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fragt beim Öffnen und danach einmal täglich, solange die App geöffnet ist, bei GitHub nach dem neuesten Release. %2$@ › Nach Updates suchen … fragt jederzeit nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ asks GitHub for the newest release when it opens and once a day while it's open. %2$@ › Check for Updates… asks any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ consulta a GitHub cuál es la versión más reciente al abrirse y una vez al día mientras está abierto. %2$@ › Buscar actualizaciones… consulta a GitHub en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ demande à GitHub la version la plus récente à son ouverture, puis une fois par jour tant qu’il reste ouvert. %2$@ › Rechercher des mises à jour… le fait à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ खुलने पर और खुले रहने के दौरान दिन में एक बार GitHub से सबसे नया संस्करण पूछता है। %2$@ › अपडेट के लिए जाँचें… से आप कभी भी पूछ सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menanyakan rilis terbaru ke GitHub saat dibuka dan sekali sehari selama masih terbuka. %2$@ › Periksa Pembaruan… menanyakannya kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ chiede a GitHub il rilascio più recente all’apertura e una volta al giorno mentre è aperto. %2$@ › Cerca aggiornamenti… lo chiede in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は、起動時と、起動している間は1日1回、GitHubに最新のリリースを問い合わせます。%2$@ › アップデートを確認…を選ぶと、いつでも確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 실행할 때와 실행 중 하루에 한 번 GitHub에서 최신 릴리스를 확인합니다. %2$@ › 업데이트 확인…에서 언제든 확인할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ menyemak keluaran terbaharu di GitHub apabila dibuka dan sekali sehari semasa ia terbuka. %2$@ › Semak Kemas Kini… menyemaknya pada bila-bila masa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vraagt GitHub bij het openen om de nieuwste release, en daarna eenmaal per dag zolang de app open is. %2$@ › Zoek naar updates… doet dat op elk moment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sprawdza na GitHub najnowsze wydanie po otwarciu i raz dziennie, gdy aplikacja jest otwarta. Polecenie %2$@ › Sprawdź dostępność aktualizacji… robi to w dowolnej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ pergunta ao GitHub qual é a versão mais recente quando abre e uma vez por dia enquanto fica aberto. %2$@ › Verificar atualizações… pergunta a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ запрашивает у GitHub последний релиз при запуске и раз в сутки, пока приложение открыто. Пункт меню %2$@ › Проверить обновления… делает это в любой момент."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ จะตรวจสอบรีลีสล่าสุดกับ GitHub เมื่อเปิดแอป และวันละครั้งขณะที่เปิดอยู่ ส่วน %2$@ › ตรวจสอบการอัปเดต… จะตรวจสอบเมื่อใดก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, açıldığında ve açık kaldığı sürece günde bir kez GitHub’a en yeni sürümü sorar. %2$@ › Güncellemeleri Denetle… ise istediğiniz zaman sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ запитує в GitHub найновіший реліз під час запуску та раз на день, поки програма відкрита. Команда %2$@ › Перевірити оновлення… робить це в будь-який момент."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hỏi GitHub về bản phát hành mới nhất khi mở và mỗi ngày một lần khi đang mở. %2$@ › Kiểm tra cập nhật… sẽ hỏi bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会在打开时以及运行期间每天一次向 GitHub 查询最新版本。你也可以随时通过 %2$@ › 检查更新… 来查询。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 會在打開時，以及執行期間每天一次，向 GitHub 查詢最新發行版本。%2$@ › 檢查更新… 可隨時查詢。"
          }
        }
      }
