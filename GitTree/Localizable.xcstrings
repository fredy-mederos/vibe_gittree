        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์ของเวิร์กทรีนี้หายไปแล้ว git worktree prune จะลบเวิร์กทรีนี้ออกจากบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasörü yok; git worktree prune onu unutur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його папки більше немає; git worktree prune прибрав би його зі списку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục của nó đã mất; git worktree prune sẽ xóa thông tin về nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的文件夹已不存在；git worktree prune 会将其清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的檔案夾已不存在；git worktree prune 會將它移除。"
          }
        }
      }
    },
    "Its folder, %@, is deleted with the files git ignores there (build products, say). Git won't delete a worktree with uncommitted changes or new files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلدها %@ سيُحذف مع الملفات التي يتجاهلها git فيه (مثل نواتج البناء). ولن يحذف git شجرة عمل بها تغييرات غير مودعة أو ملفات جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Ordner %@ wird samt den Dateien gelöscht, die git dort ignoriert (etwa Build-Produkte). Git löscht keinen Worktree mit nicht committeten Änderungen oder neuen Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carpeta, %@, se elimina junto con los archivos que git ignora allí (por ejemplo, productos de compilación). Git no elimina un worktree con cambios sin commit ni archivos nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son dossier %@ est supprimé avec les fichiers que git y ignore (produits de compilation, par exemple). Git ne supprime pas un worktree comportant des modifications non validées ou de nouveaux fichiers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका फ़ोल्डर %@ उन फ़ाइलों समेत डिलीट हो जाएगा जिन्हें git वहाँ अनदेखा करता है (जैसे बिल्ड के उत्पाद)। Git ऐसी वर्कट्री डिलीट नहीं करेगा जिसमें कमिट न किए गए बदलाव या नई फ़ाइलें हों।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldernya, %@, akan dihapus beserta berkas yang diabaikan git di dalamnya (misalnya hasil build). Git tidak akan menghapus worktree yang memiliki perubahan yang belum di-commit atau berkas baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua cartella, %@, viene eliminata insieme ai file che git ignora lì (per esempio i prodotti di build). Git non elimina un worktree con modifiche non committate o nuovi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ%@は、gitが無視するファイル（ビルド生成物など）とともに削除されます。gitは、未コミットの変更や新しいファイルがあるワークツリーは削除しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 폴더는 git이 그곳에서 무시하는 파일(예: 빌드 산출물)과 함께 삭제됩니다. git은 커밋하지 않은 변경 사항이나 새 파일이 있는 워크트리는 삭제하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldernya, %@, dipadam bersama fail yang diabaikan git di situ (contohnya hasil binaan). Git tidak akan memadam worktree yang mempunyai perubahan yang belum di-commit atau fail baharu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map %@ wordt samen met de bestanden die git daar negeert (bijvoorbeeld buildproducten) verwijderd. Git verwijdert geen worktree met niet-gecommitte wijzigingen of nieuwe bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego folder %@ zostanie usunięty razem z plikami, które git tam ignoruje (np. wynikami kompilacji). Git nie usunie worktree z niezatwierdzonymi zmianami ani nowymi plikami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta dela, %@, é excluída junto com os arquivos que o git ignora ali (por exemplo, produtos de build). O git não exclui uma worktree com alterações sem commit ou arquivos novos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка %@ удаляется вместе с файлами, которые git там игнорирует (например, продукты сборки). Git не удаляет рабочее дерево с незакоммиченными изменениями или новыми файлами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์ของเวิร์กทรีนี้ %@ จะถูกลบพร้อมไฟล์ที่ git ไม่สนใจในโฟลเดอร์นั้น (เช่น ผลลัพธ์จากการบิลด์) git จะไม่ลบเวิร์กทรีที่มีการเปลี่ยนแปลงที่ยังไม่ได้คอมมิตหรือไฟล์ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ klasörü, git’in orada yok saydığı dosyalarla birlikte silinir (örneğin derleme ürünleri). Git, commit edilmemiş değişiklikleri veya yeni dosyaları olan bir worktree’yi silmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його папка %@ буде видалена разом із файлами, які git там ігнорує (наприклад, продукти збирання). Git не видалить worktree з незакоміченими змінами чи новими файлами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục của nó, %@, sẽ bị xóa cùng các tệp mà git bỏ qua ở đó (ví dụ: sản phẩm build). Git không xóa worktree có thay đổi chưa commit hoặc tệp mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的文件夹 %@ 会连同 git 在其中忽略的文件（例如构建产物）一并删除。Git 不会删除含有未提交更改或新文件的工作树。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的檔案夾 %@ 會連同 git 在其中忽略的檔案（例如建置產物）一併刪除。Git 不會刪除含有未提交變更或新檔案的工作樹。"
          }
        }
      }
    },
