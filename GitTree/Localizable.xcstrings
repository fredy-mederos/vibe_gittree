    "“%@” is deleted with its changes. Vibe GitTree can't bring it back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحذف «%@» مع تغييراته. لا يستطيع Vibe GitTree استعادته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird mit seinen Änderungen gelöscht. Vibe GitTree kann ihn nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se elimina con sus cambios. Vibe GitTree no puede recuperarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est supprimé avec ses modifications. Vibe GitTree ne peut pas le rétablir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” अपने बदलावों समेत डिलीट हो जाता है। Vibe GitTree इसे वापस नहीं ला सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” akan dihapus beserta perubahannya. Vibe GitTree tidak dapat memulihkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà eliminato insieme alle sue modifiche. Vibe GitTree non può ripristinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はその変更とともに削除されます。Vibe GitTreeでは元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 스태시는 변경 사항과 함께 삭제됩니다. Vibe GitTree에서는 복원할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dipadam bersama perubahannya. Vibe GitTree tidak dapat memulihkannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” wordt samen met de wijzigingen verwijderd. Vibe GitTree kan het niet terughalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stash „%@” zostanie usunięty wraz ze zmianami. Vibe GitTree nie może go przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é excluído com as alterações dele. O Vibe GitTree não consegue recuperá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стэш «%@» будет удалён вместе с его изменениями. Vibe GitTree не сможет его вернуть."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” จะถูกลบพร้อมการเปลี่ยนแปลง Vibe GitTree ไม่สามารถนำกลับมาได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” değişiklikleriyle birlikte silinir. Vibe GitTree bunu geri getiremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» буде видалено разом зі змінами. Vibe GitTree не зможе його повернути."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sẽ bị xóa cùng các thay đổi của nó. Vibe GitTree không thể khôi phục lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其更改将被删除。Vibe GitTree 无法将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」會連同其變更一併刪除，Vibe GitTree 無法復原。"
          }
        }
      }
    },
    "“%@” isn't a git repository. Choose the folder that contains the .git folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجلد «%@» ليس مستودع git. اختر المجلد الذي يحتوي على المجلد .git."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist kein git-Repository. Wähle den Ordner aus, der den Ordner .git enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un repositorio git. Elige la carpeta que contiene la carpeta .git."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un dépôt git. Choisissez le dossier qui contient le dossier .git."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” git रिपॉज़िटरी नहीं है। वह फ़ोल्डर चुनें जिसमें .git फ़ोल्डर हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bukan repositori git. Pilih folder yang berisi folder .git."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un repository git. Scegli la cartella che contiene la cartella .git."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はgitリポジトリではありません。.gitフォルダを含むフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 폴더는 git 저장소가 아닙니다. .git 폴더가 들어 있는 폴더를 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bukan repositori git. Pilih folder yang mengandungi folder .git."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is geen git-repository. Kies de map die de .git-map bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nie jest repozytorium git. Wybierz folder, który zawiera folder .git."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é um repositório git. Escolha a pasta que contém a pasta .git."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не git-репозиторий. Выберите папку, в которой находится папка .git."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ไม่ใช่รีโพซิทอรี git เลือกโฟลเดอร์ที่มีโฟลเดอร์ .git"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bir git deposu değil. .git klasörünü içeren klasörü seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не є репозиторієм git. Виберіть папку, що містить папку .git."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” không phải là kho lưu trữ git. Hãy chọn thư mục chứa thư mục .git."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 git 仓库。请选择包含 .git 文件夹的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是 git 儲存庫。請選擇包含 .git 檔案夾的那個檔案夾。"
          }
        }
