    "They share no history, so there's nothing to diff against." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يشتركان في أي سجل، لذا لا يوجد ما يمكن مقارنته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide haben keinen gemeinsamen Verlauf, daher gibt es nichts zu vergleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No comparten historial, así que no hay nada con lo que comparar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun historique commun : il n’y a rien à comparer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनका कोई साझा इतिहास नहीं है, इसलिए डिफ़ करने के लिए कुछ नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keduanya tidak memiliki riwayat yang sama, jadi tidak ada yang dapat dibandingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hanno una cronologia in comune, quindi non c’è nulla con cui confrontarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴を共有していないため、比較できる差分がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공통 히스토리가 없어 비교할 대상이 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua-duanya tidak berkongsi sejarah, jadi tiada apa-apa untuk dibandingkan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze delen geen geschiedenis, dus er is niets om mee te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gałęzie nie mają wspólnej historii, więc nie ma z czym porównywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles não compartilham histórico, então não há nada para comparar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У них нет общей истории, поэтому сравнивать не с чем."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีประวัติร่วมกัน จึงไม่มีสิ่งที่จะนำมาเปรียบเทียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortak geçmişleri yok, bu yüzden karşılaştırılacak bir şey yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони не мають спільної історії, тож порівнювати нема з чим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng không có lịch sử chung, nên không có gì để so sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们没有共同的历史，所以无从比较差异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者沒有共同的歷史記錄，所以無從比較差異。"
          }
        }
      }
    },
