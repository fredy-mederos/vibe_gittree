    "Ask Jira again about the fix versions and the tickets of the open ones" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسأل Jira مرة أخرى عن إصدارات الإصلاح، وعن تذاكر الإصدارات المفتوحة منها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira erneut nach den Fix-Versionen und den Tickets der offenen fragen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a consultar en Jira las versiones de corrección y los tickets de las abiertas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interroger de nouveau Jira sur les versions corrigées et sur les tickets de celles qui sont ouvertes"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िक्स वर्ज़न और जो ओपन हैं उनके टिकट के बारे में Jira से फिर से पूछें"
          }
        },
        "id" : {
