    "Both sides changed these files. Resolve them in your editor, then stage them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر الطرفان هذه الملفات. عالج التعارضات في المحرر الذي تستخدمه، ثم جهّزها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Seiten haben diese Dateien geändert. Löse die Konflikte in deinem Editor und merke die Dateien anschließend zum Commit vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos lados modificaron estos archivos. Resuélvelos en tu editor y luego prepáralos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux côtés ont modifié ces fichiers. Résolvez-les dans votre éditeur, puis indexez-les."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों पक्षों ने इन फ़ाइलों को बदला है। इन्हें अपने एडिटर में हल करें, फिर स्टेज करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua sisi mengubah berkas-berkas ini. Selesaikan konfliknya di editor Anda, lalu stage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i lati hanno modificato questi file. Risolvili nel tuo editor, poi mettili in staging."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのファイルは双方で変更されています。エディタで解決してから、ステージしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양쪽에서 이 파일을 변경했습니다. 편집기에서 충돌을 해결한 다음 스테이징하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua-dua pihak mengubah fail ini. Selesaikan konflik dalam editor anda, kemudian stage fail tersebut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide kanten hebben deze bestanden gewijzigd. Los de conflicten op in je editor en stage ze daarna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obie strony zmieniły te pliki. Rozwiąż konflikty w edytorze, a potem dodaj je do indeksu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dois lados alteraram estes arquivos. Resolva-os no seu editor e depois prepare-os."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обе стороны изменили эти файлы. Разрешите конфликты в редакторе, затем добавьте файлы в индекс."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทั้งสองฝั่งเปลี่ยนแปลงไฟล์เหล่านี้ ให้แก้ไขในเอดิเตอร์ของคุณ แล้วสเตจไฟล์เหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosyaları her iki taraf da değiştirdi. Düzenleyicinizde çözün, ardından stage’e alın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обидві сторони змінили ці файли. Розв’яжіть конфлікти у своєму редакторі, а потім додайте файли до індексу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả hai phía đều đã thay đổi các tệp này. Hãy giải quyết xung đột trong trình soạn thảo của bạn, rồi stage chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些文件在双方都被更改了。请在编辑器中解决冲突，然后暂存它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雙方都變更了這些檔案。請在編輯器中解決衝突，然後暫存它們。"
          }
        }
      }
    },
