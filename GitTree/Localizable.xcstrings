          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์ของเวิร์กทรีนี้หายไปแล้ว git จึงลืมเวิร์กทรีนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
