            "value" : "इसे लागू या ड्रॉप किया जा चुका है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stash sudah diterapkan atau di-drop."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato applicato o eliminato."
