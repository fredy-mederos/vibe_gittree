    "Already merged: its commits were rebased or cherry-picked into the main branch" : {
      "comment" : "Tooltip of the newest commit of a branch no merge brings in, but whose every commit the main branch has a copy of (same subject, author and date), made by a rebase or cherry-pick",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدمج بالفعل: نُسخت إيداعاته إلى الفرع الرئيسي عبر rebase أو cherry-pick"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits zusammengeführt: Die Commits wurden per Rebase oder Cherry-Pick in den Main-Branch übernommen"
          }
        },
        "es" : {
          "stringUnit" : {
