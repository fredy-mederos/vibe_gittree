    "Epic: %@ %@" : {
      "comment" : "An epic's key and summary",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملحمة: %1$@ %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
