        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deels gestaged: het staat onder Gestaged en Niet gestaged"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Częściowo w indeksie: jest w sekcjach „W indeksie” i „Poza indeksem”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcialmente preparado: está em Preparados e Não preparados"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частично в индексе: файл есть в разделах «В индексе» и «Не в индексе»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สเตจบางส่วน: อยู่ทั้งใน “สเตจแล้ว” และ “ยังไม่สเตจ”"
          }
        },
        "tr" : {
