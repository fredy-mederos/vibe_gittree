    "Vibe GitTree downloads the commit history and folder structure, without file contents, into its own storage. Your other folders aren't touched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل Vibe GitTree سجل الإيداعات وبنية المجلدات، دون محتويات الملفات، إلى مساحة التخزين الخاصة به. لا تتأثر مجلداتك الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree lädt den Commit-Verlauf und die Ordnerstruktur, ohne Dateiinhalte, in seinen eigenen Speicher. Deine anderen Ordner bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree descarga el historial de commits y la estructura de carpetas, sin el contenido de los archivos, en su propio almacenamiento. Tus otras carpetas no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree télécharge l’historique des commits et l’arborescence des dossiers, sans le contenu des fichiers, dans son propre espace de stockage. Vos autres dossiers ne sont pas touchés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree कमिट इतिहास और फ़ोल्डर संरचना को, फ़ाइलों की सामग्री के बिना, अपने स्टोरेज में डाउनलोड करता है। आपके दूसरे फ़ोल्डरों को छुआ नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree mengunduh riwayat commit dan struktur folder, tanpa isi berkas, ke penyimpanannya sendiri. Folder Anda yang lain tidak tersentuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree scarica la cronologia dei commit e la struttura delle cartelle, senza il contenuto dei file, nel proprio spazio di archiviazione. Le tue altre cartelle non vengono toccate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTreeは、ファイルの内容を除くコミット履歴とフォルダ構造を、独自のストレージにダウンロードします。ほかのフォルダには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree는 파일 내용 없이 커밋 히스토리와 폴더 구조만 자체 저장 공간에 다운로드합니다. 다른 폴더는 건드리지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree memuat turun sejarah commit dan struktur folder, tanpa kandungan fail, ke dalam storannya sendiri. Folder anda yang lain tidak disentuh."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree downloadt de commitgeschiedenis en mapstructuur, zonder bestandsinhoud, naar een eigen opslaglocatie. Je andere mappen blijven ongemoeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree pobiera historię commitów i strukturę folderów, bez zawartości plików, do własnego magazynu. Inne foldery pozostają nietknięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vibe GitTree baixa o histórico de commits e a estrutura de pastas, sem o conteúdo dos arquivos, para o próprio armazenamento. Suas outras pastas ficam intactas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree загружает историю коммитов и структуру папок, без содержимого файлов, в собственное хранилище. Остальные ваши папки не затрагиваются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree จะดาวน์โหลดประวัติคอมมิตและโครงสร้างโฟลเดอร์ โดยไม่รวมเนื้อหาไฟล์ ไปยังที่จัดเก็บของตัวเอง โฟลเดอร์อื่นของคุณจะไม่ถูกแตะต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree, commit geçmişini ve klasör yapısını, dosya içerikleri olmadan, kendi depolama alanına indirir. Diğer klasörlerinize dokunulmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree завантажує історію комітів і структуру папок, без вмісту файлів, у власне сховище. Решта ваших папок не зачіпається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree tải lịch sử commit và cấu trúc thư mục, không kèm nội dung tệp, vào vùng lưu trữ riêng của nó. Các thư mục khác của bạn không bị đụng đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree 会将提交历史和文件夹结构（不含文件内容）下载到它自己的存储位置。你的其他文件夹不会受到影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe GitTree 會把提交歷史記錄和檔案夾結構（不含檔案內容）下載到自己的儲存空間。你的其他檔案夾不會受到影響。"
          }
        }
      }
    },
