    "Hover over a day to see its tickets and commits; click a day to keep it here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر المؤشر فوق يوم لرؤية تذاكره وإيداعاته؛ انقر على يوم لتثبيته هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Mauszeiger über einen Tag, um seine Tickets und Commits zu sehen; klicke auf einen Tag, um ihn hier festzuhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el puntero sobre un día para ver sus tickets y commits; haz clic en un día para dejarlo fijado aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez un jour pour voir ses tickets et ses commits ; cliquez sur un jour pour le garder ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी दिन पर पॉइंटर ले जाकर उसके टिकट और कमिट देखें; उसे यहाँ बनाए रखने के लिए दिन पर क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan kursor ke sebuah hari untuk melihat tiket dan commit-nya; klik sebuah hari untuk menyematkannya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posiziona il puntatore su un giorno per vedere i suoi ticket e commit; fai clic su un giorno per fissarlo qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日にポインタを合わせると、その日の課題とコミットが表示されます。日をクリックすると、ここに固定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜 위에 포인터를 올리면 해당 날짜의 티켓과 커밋이 표시되고, 날짜를 클릭하면 여기에 고정됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halakan penuding ke atas sesuatu hari untuk melihat tiket dan commitnya; klik sesuatu hari untuk mengekalkannya di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de aanwijzer over een dag om de tickets en commits te zien; klik op een dag om die hier vast te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najedź kursorem na dzień, aby zobaczyć jego zgłoszenia i commity; kliknij dzień, aby zachować go tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o cursor sobre um dia para ver os tickets e commits dele; clique em um dia para mantê-lo aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите курсор на день, чтобы увидеть его тикеты и коммиты; нажмите на день, чтобы закрепить его здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางตัวชี้เหนือวันเพื่อดูทิกเก็ตและคอมมิตของวันนั้น คลิกวันเพื่อปักหมุดไว้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ticket’lerini ve commit’lerini görmek için bir günün üzerine gelin; burada tutmak için bir güne tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведіть вказівник на день, щоб побачити його тікети й коміти; клацніть день, щоб закріпити їх тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuột qua một ngày để xem ticket và commit của ngày đó; nhấp vào một ngày để giữ nó ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针移到某一天上可查看其工单和提交；点按某一天可将其固定在此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標移到某一天上可查看其議題與提交；按一下某一天可將它保留在這裡。"
          }
        }
      }
    },
