    "Add a repository from your Mac, or clone one from a URL to explore its history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف مستودعًا من جهاز Mac، أو استنسخ مستودعًا من عنوان URL لاستكشاف سجلّه."
          }
        },
        "de" : {
          "stringUnit" : {
