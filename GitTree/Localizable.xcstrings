    "Partly staged: it's under Staged and Not Staged" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجهّز جزئيًا: يظهر ضمن «المجهّزة» و«غير المجهّزة»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilweise vorgemerkt: Die Datei steht unter „Vorgemerkt“ und „Nicht vorgemerkt“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparado en parte: aparece en Preparados y en Sin preparar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partiellement indexé : il figure sous « Indexés » et « Non indexés »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आंशिक रूप से स्टेज्ड: यह स्टेज्ड और अनस्टेज्ड दोनों में है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagian di-stage: ada di “Di-stage” dan “Belum Di-stage”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parzialmente in staging: compare sia in “In staging” sia in “Non in staging”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部ステージ済み: 「ステージ済み」と「未ステージ」の両方にあります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부만 스테이징됨: “스테이징됨”과 “스테이징되지 않음”에 모두 표시됩니다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebahagian staged: ia berada di bawah Staged dan Belum Staged"
