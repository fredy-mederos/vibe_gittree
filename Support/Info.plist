<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates. Registers gittree:// deep links. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Only for local test servers; everything on the internet still needs HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The commit an installed copy was built from; scripts/install.sh fills it in. -->
	<key>GTBuildCommit</key>
	<string>$(GT_BUILD_COMMIT)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.fredymederos.GitTree</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gittree</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
